# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=your-jwt-secret-here
# Comma-separated for multiple origins (local + production)
FRONTEND_URL=http://localhost:5173,https://app.auradesk.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/auradesk?schema=public

# Token Encryption
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# AWS (required for file uploads in production)
AWS_REGION=us-east-1
S3_UPLOADS_BUCKET=auradesk-uploads-staging

# Meta (Facebook, Instagram, WhatsApp)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
FACEBOOK_REDIRECT_URI=https://api.auradesk.com/auth/facebook/callback
INSTAGRAM_REDIRECT_URI=https://api.auradesk.com/auth/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WABA_ID=your-whatsapp-business-account-id
WHATSAPP_SYSTEM_USER_TOKEN=your-system-user-permanent-access-token

# Google / Gmail
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.auradesk.com/auth/gmail/callback

# Gmail Pub/Sub (real-time notifications)
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT_ID/topics/gmail-push

# Stripe (optional — payment endpoints return 501 if not set)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
