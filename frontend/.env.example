# ─────────────────────────────────────────────────────────────────
# Frontend environment variables (Vite)
#
# Vite only exposes variables prefixed with VITE_ to client code.
# These values are PUBLIC — they get baked into the production
# bundle and are visible to anyone who opens DevTools.
#
# NEVER put secret keys here:
#   ❌ STRIPE_SECRET_KEY     (server-only — backend/.env)
#   ❌ STRIPE_WEBHOOK_SECRET (server-only — backend/.env)
#   ❌ JWT_SECRET            (server-only — backend/.env)
#   ❌ DATABASE_URL          (server-only — backend/.env)
# ─────────────────────────────────────────────────────────────────

# Backend API base URL — no trailing slash
# Local dev:        http://localhost:3001
# Production (e.g): https://api.auradesk.com
VITE_API_URL=http://localhost:3001

# Stripe publishable key (safe to expose)
# Use the TEST key (pk_test_…) in development and the LIVE key
# (pk_live_…) only in production. Never paste a secret key here.
# Get yours at: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Meta App ID (public — used for the Facebook/Instagram OAuth popup)
VITE_META_APP_ID=your-meta-app-id

# WhatsApp embedded signup config ID (public)
VITE_WA_CONFIG_ID=your-whatsapp-config-id
