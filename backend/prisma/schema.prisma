generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String   @map("password_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  // ── Password Reset ──
  // Stores SHA-256 hash of the raw token (never the raw token itself).
  // Single-use: cleared after a successful reset. Expires after 10 minutes.
  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  // ── Trial & Subscription ──
  plan              PlanType    @default(trial)
  trialEndsAt       DateTime?   @map("trial_ends_at")
  subscriptionStatus SubStatus  @default(trialing) @map("subscription_status")
  isSubscribed      Boolean     @default(false) @map("is_subscribed")
  stripeCustomerId  String?     @unique @map("stripe_customer_id")
  stripeSubscriptionId String?  @unique @map("stripe_subscription_id")
  currentPeriodStart DateTime?  @map("current_period_start")
  currentPeriodEnd  DateTime?   @map("current_period_end")
  cancelAtPeriodEnd Boolean     @default(false) @map("cancel_at_period_end")
  // When set, the user is in grace period after a failed payment.
  // Access is denied once we pass this timestamp.
  gracePeriodEndsAt DateTime?   @map("grace_period_ends_at")
  billingCycle      BillingCycle? @map("billing_cycle")

  // ── Plan limits / usage (Phase 1 — log-only enforcement) ──
  // `aiRepliesUsed` counts AI replies consumed in the CURRENT billing cycle.
  // Reset to 0 whenever `currentPeriodStart` rolls forward (handled in the
  // Stripe webhook + lazy-reset inside planGuard.assertAndConsumeAiReply).
  // `aiRepliesCycleStart` is the anchor timestamp for the current window,
  // used to detect whether a reset is needed without a separate cron job.
  // `planOverrides` is an optional JSON blob that shallow-merges on top of
  // PLAN_LIMITS[plan] — reserved for enterprise deals. NULL on all normal
  // users; safe to leave unset.
  aiRepliesUsed        Int       @default(0)  @map("ai_replies_used")
  aiRepliesCycleStart  DateTime? @map("ai_replies_cycle_start")
  planOverrides        Json?     @map("plan_overrides")

  // ── Onboarding ──
  // `onboardingStep` is a UI breadcrumb for the multi-step wizard.
  // `onboardingCompleted` is the canonical "is this user fully onboarded"
  // flag — set the moment the organization (branding) step completes,
  // regardless of whether they connected any platforms. This is the only
  // value the route guards check; do NOT gate access on onboardingStep.
  onboardingStep      Int      @default(0) @map("onboarding_step")  // 0=not started, 1=branding, 2=platforms, 3=first-message, 4=complete
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  companyName       String?     @map("company_name")
  companyLogo       String?     @map("company_logo")
  brandColor        String?     @map("brand_color")
  firstName         String?     @map("first_name")
  lastName          String?     @map("last_name")
  cannedResponse    String?     @map("canned_response")

  // ── Team / Workspace ──
  role            UserRole  @default(owner)
  inviterUserId   String?   @map("inviter_user_id")
  inviter         User?     @relation("TeamMembers", fields: [inviterUserId], references: [id], onDelete: SetNull)
  teamMembers     User[]    @relation("TeamMembers")

  connectedAccounts ConnectedAccount[]
  contacts          Contact[]
  leads             Lead[]
  invoices          Invoice[]
  sentInvites       TeamInvite[] @relation("InviterInvites")
  aiReplyUsage      AiReplyUsage[]

  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════
// AI reply usage audit log
// ───────────────────────────────────────────────────────────────────
// One row per AI reply consumed. Backs the monthly quota counter on
// User.aiRepliesUsed but also preserves a durable history for audit,
// refund, and analytics. Scoped to the WORKSPACE OWNER's userId — team
// members share the owner's quota. Cascade delete so closing an account
// cleans up naturally.
// ═══════════════════════════════════════════════════════════════════
model AiReplyUsage {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  platform       Platform?
  conversationId String?   @map("conversation_id")
  cost           Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_reply_usage")
}

enum UserRole {
  owner
  admin
  member
}

model TeamInvite {
  id          String       @id @default(uuid())
  inviterId   String       @map("inviter_id")
  email       String
  role        UserRole     @default(member)
  token       String       @unique
  status      InviteStatus @default(pending)
  expiresAt   DateTime     @map("expires_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  acceptedAt  DateTime?    @map("accepted_at")

  inviter     User         @relation("InviterInvites", fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([inviterId, email])
  @@index([token])
  @@map("team_invites")
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

// ═══════════════════════════════════════════════════════════════════
// CRM: Leads, Invoices, Payments
// ═══════════════════════════════════════════════════════════════════

model Lead {
  id              String     @id @default(uuid())
  userId          String     @map("user_id")
  name            String
  platform        String?
  lastContactedAt DateTime?  @map("last_contacted_at")
  lastAction      String?    @map("last_action")
  status          LeadStatus @default(New)
  conversationId  String?    @unique @map("conversation_id")
  email           String?
  phone           String?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices        Invoice[]

  @@index([userId])
  @@map("leads")
}

enum LeadStatus {
  New
  Warm
  Won
  Lost
}

model Invoice {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  leadId         String?       @map("lead_id")
  invoiceNumber  String        @map("invoice_number")
  publicSlug     String        @unique @map("public_slug")
  clientName     String        @map("client_name")
  clientEmail    String?       @map("client_email")
  clientPhone    String?       @map("client_phone")
  billingAddress String?       @map("billing_address")
  issueDate      DateTime      @map("issue_date")
  dueDate        DateTime      @map("due_date")
  note           String?
  currency       String        @default("USD")
  taxRate        Float         @default(0) @map("tax_rate")
  subtotal       Float         @default(0)
  taxAmount      Float         @default(0) @map("tax_amount")
  total          Float         @default(0)
  status         InvoiceStatus @default(Draft)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  items          InvoiceItem[]
  payments       Payment[]

  @@index([userId])
  @@index([leadId])
  @@map("invoices")
}

enum InvoiceStatus {
  Draft
  Sent
  Paid
  Overdue
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0) @map("unit_price")
  amount      Float   @default(0)
  position    Int     @default(0)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id        String      @id @default(uuid())
  invoiceId String      @map("invoice_id")
  amount    Float
  date      DateTime    @default(now())
  type      PaymentType @default(Partial)
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")

  invoice   Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

enum PaymentType {
  Deposit
  Partial
  Full
}

enum PlanType {
  trial
  starter
  pro
  elite
  expired
}

enum SubStatus {
  trialing
  active
  past_due
  canceled
  expired
}

enum BillingCycle {
  monthly
  yearly
}

model ConnectedAccount {
  id                     String   @id @default(uuid())
  userId                 String   @map("user_id")
  platform               Platform
  platformAccountId      String   @map("platform_account_id")
  displayName            String?  @map("display_name")
  avatarUrl              String?  @map("avatar_url")
  status                 AccountStatus @default(active)
  gmailHistoryId         String?  @map("gmail_history_id")
  gmailWatchExpiration   DateTime? @map("gmail_watch_expiration")
  createdAt              DateTime @default(now()) @map("created_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authToken         AuthToken?
  whatsappAccount   WhatsappAccount?
  conversations     Conversation[]
  webhookSubscriptions WebhookSubscription[]

  @@unique([userId, platform, platformAccountId])
  @@map("connected_accounts")
}

model AuthToken {
  id                     String   @id @default(uuid())
  connectedAccountId     String   @unique @map("connected_account_id")
  accessTokenEncrypted   String   @map("access_token_encrypted")
  refreshTokenEncrypted  String?  @map("refresh_token_encrypted")
  expiresAt              DateTime? @map("expires_at")
  tokenType              String?  @map("token_type")
  scopes                 String?
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  connectedAccount       ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@map("auth_tokens")
}

model WhatsappAccount {
  id                String   @id @default(uuid())
  connectedAccountId String  @unique @map("connected_account_id")
  wabaId            String   @map("waba_id")
  phoneNumberId     String   @map("phone_number_id")
  phoneNumber       String   @map("phone_number")
  businessName      String?  @map("business_name")
  webhookVerified   Boolean  @default(false) @map("webhook_verified")
  createdAt         DateTime @default(now()) @map("created_at")

  connectedAccount  ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@map("whatsapp_accounts")
}

model Contact {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  platform        Platform
  platformUserId  String   @map("platform_user_id")
  name            String?
  username        String?
  avatarUrl       String?  @map("avatar_url")
  createdAt       DateTime @default(now()) @map("created_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations   Conversation[]

  @@unique([userId, platform, platformUserId])
  @@map("contacts")
}

model Conversation {
  id                       String   @id @default(uuid())
  connectedAccountId       String   @map("connected_account_id")
  platformConversationId   String   @map("platform_conversation_id")
  contactId                String?  @map("contact_id")
  lastMessageAt            DateTime? @map("last_message_at")
  status                   ConversationStatus @default(open)
  unreadCount              Int      @default(0) @map("unread_count")
  isStarred                Boolean  @default(false) @map("is_starred")
  isLead                   Boolean  @default(false) @map("is_lead")
  isDeleted                Boolean  @default(false) @map("is_deleted")
  deletedAt                DateTime? @map("deleted_at")
  createdAt                DateTime @default(now()) @map("created_at")

  connectedAccount         ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  contact                  Contact? @relation(fields: [contactId], references: [id])
  messages                 Message[]
  drafts                   Draft[]

  @@unique([connectedAccountId, platformConversationId])
  @@map("conversations")
}

model Message {
  id                  String   @id @default(uuid())
  conversationId      String   @map("conversation_id")
  platformMessageId   String?  @map("platform_message_id")
  direction           MessageDirection
  sender              String?
  subject             String?
  content             String?
  htmlContent         String?  @map("html_content")
  contentType         ContentType @default(text) @map("content_type")
  attachments         Json?
  sentAt              DateTime @default(now()) @map("sent_at")
  deliveredAt         DateTime? @map("delivered_at")
  readAt              DateTime? @map("read_at")
  status              MessageStatus @default(sent)
  rawPayload          Json?    @map("raw_payload")

  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, platformMessageId], name: "conversation_platform_message")
  @@map("messages")
}

model Draft {
  id              String   @id @default(uuid())
  conversationId  String   @map("conversation_id")
  content         String?
  subject         String?
  attachments     Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId])
  @@map("drafts")
}

model WebhookSubscription {
  id                 String   @id @default(uuid())
  connectedAccountId String   @map("connected_account_id")
  platform           Platform
  subscriptionId     String?  @map("subscription_id")
  subscribedFields   String?  @map("subscribed_fields")
  verifiedAt         DateTime? @map("verified_at")
  createdAt          DateTime @default(now()) @map("created_at")

  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@map("webhook_subscriptions")
}

model WebhookEventLog {
  id         String   @id @default(uuid())
  platform   Platform
  receivedAt DateTime @default(now()) @map("received_at")
  payload    Json
  processed  Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("webhook_events_log")
}

enum Platform {
  facebook
  instagram
  whatsapp
  gmail
}

enum AccountStatus {
  active
  token_expired
  disconnected
  pending_review
}

enum ConversationStatus {
  open
  closed
  archived
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

enum ContentType {
  text
  image
  audio
  video
  file
  sticker
  email
}
