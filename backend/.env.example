# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=your-jwt-secret-here
# Plan limit enforcement: 'off' | 'log' | 'enforce'
PLAN_ENFORCEMENT_MODE=log
# Comma-separated for multiple origins (local + production)
FRONTEND_URL=http://localhost:5173,https://app.auradesk.com
# Single canonical frontend URL for Stripe success/cancel redirects
APP_URL=https://app.auradesk.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/auradesk?schema=public

# Token Encryption
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# AWS (required for file uploads in production)
AWS_REGION=eu-north-1
S3_UPLOADS_BUCKET=auradesk-uploads-staging

# AWS SES (transactional email)
SES_FROM_EMAIL=team@slasheasy.com
SES_FROM_NAME=AuraDesk
SES_CONFIGURATION_SET=auradesk-staging

# Meta (Facebook, Instagram, WhatsApp)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
FACEBOOK_REDIRECT_URI=https://api.auradesk.com/auth/facebook/callback
INSTAGRAM_REDIRECT_URI=https://api.auradesk.com/auth/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WABA_ID=your-whatsapp-business-account-id
WHATSAPP_SYSTEM_USER_TOKEN=your-system-user-permanent-access-token

# Google / Gmail
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.auradesk.com/auth/gmail/callback

# Gmail Pub/Sub (real-time notifications)
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT_ID/topics/gmail-push

# ─────────────────────────────────────────────────────────────────
# Stripe — SERVER-ONLY KEYS. NEVER expose these to the frontend.
# Payment endpoints return 501 if STRIPE_SECRET_KEY is not set.
#
# Use TEST keys (sk_test_…/whsec_…) in dev and LIVE keys
# (sk_live_…) ONLY in production. The startup sanity check in
# subscription.js will warn loudly if these are mismatched or if
# a publishable key is pasted in by mistake.
#
# Get keys:    https://dashboard.stripe.com/apikeys
# Get webhook: https://dashboard.stripe.com/webhooks
#              → create endpoint pointing to
#                https://<your-backend>/api/subscription/webhook
#              → copy the "Signing secret" (whsec_…)
# ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# NOTE: The frontend uses a separate PUBLISHABLE key
# (VITE_STRIPE_PUBLISHABLE_KEY in frontend/.env). Both keys must
# come from the same Stripe account AND the same mode (both test
# or both live), otherwise checkout sessions created by this
# server will not load on the frontend.
